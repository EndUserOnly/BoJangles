{
  "schema": 1,
  "tool": "Nuitka",
  "version": "4.3.1",
  "arguments": [
    "env",
    "-i",
    "PATH=/opt/bojangles-build-tools/bin:/usr/bin:/bin",
    "HOME=/opt/bojangles-builder-home",
    "LANG=C.UTF-8",
    "PYTHONPATH=/opt/bojangles-app-source:/opt/bojangles-compiler-tools",
    "PYTHONDONTWRITEBYTECODE=1",
    "TMPDIR=/opt/bojangles-app-tmp",
    "NUITKA_CACHE_DIR=/opt/bojangles-app-cache",
    "CFLAGS=-ffile-prefix-map=/opt/bojangles-app-source=/usr/src/bojangles-app -ffile-prefix-map=/opt/bojangles-app-output=/usr/src/bojangles-generated -ffile-prefix-map=/opt/bojangles-compiler-tools=/usr/src/bojangles-build-tools",
    "/opt/bojangles-app-build-venv/bin/python",
    "-B",
    "-m",
    "nuitka",
    "--mode=standalone",
    "--python-flag=-m",
    "--python-flag=safe_path",
    "--python-flag=dont_write_bytecode",
    "--include-package=bojangles",
    "--include-package=yt_dlp",
    "--include-package=yt_dlp_ejs",
    "--include-package-data=bojangles",
    "--include-package-data=yt_dlp_ejs",
    "--enable-plugin=tk-inter",
    "--user-package-configuration-file=/opt/bojangles.nuitka-package.config.yml",
    "--file-reference-choice=runtime",
    "--static-libpython=no",
    "--lto=no",
    "--jobs=4",
    "--show-progress",
    "--assume-yes-for-downloads",
    "--output-dir=/opt/bojangles-app-output",
    "--output-filename=bojangles.bin",
    "--report=/opt/bojangles-app-compilation.xml",
    "--nofollow-import-to=yt_dlp.extractor.lazy_extractors",
    "--include-module=PIL.ImageTk",
    "--noinclude-data-files=bojangles/assets/aria2/bin/*",
    "--noinclude-data-files=bojangles/assets/aria2/lib/*",
    "/opt/bojangles-app-source/bojangles"
  ],
